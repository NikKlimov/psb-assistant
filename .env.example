# extractive starts without keys. Supported: gigachat, yandex, openai, ollama.
LLM_PROVIDER=extractive
LLM_FALLBACK_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# Russian providers: set primary/fallback to gigachat and yandex after adding credentials.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_MODEL=GigaChat-3-Ultra
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_MODEL=yandexgpt-5.1
LLM_TIMEOUT=45
CACHE_PATH=data/cache.sqlite3
SNAPSHOT_PATH=artifacts/products.json
CRAWL_DELAY=2
AUTO_CRAWL=true
# Optional custom trust bundle. Never disable TLS verification.
# REQUESTS_CA_BUNDLE=artifacts/psb-ca-bundle.pem
